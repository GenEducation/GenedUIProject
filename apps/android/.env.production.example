# Production environment for Android release builds (Play Store compliance, issue H4).
# Copy this file to `.env.production` and fill in real values. Do NOT commit `.env.production`.
#
# TODO(ops): use the real production Cloud Run URL — do not ship a build with a "-dev-" host.
EXPO_PUBLIC_API_URL=https://REPLACE_WITH_PRODUCTION_GATEWAY_URL
EXPO_PUBLIC_WEB_URL=https://REPLACE_WITH_PRODUCTION_GATEWAY_URL
EXPO_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_PRODUCTION_GOOGLE_CLIENT_ID
# Licensed production Desmos key (see H2). Keep the real value out of version control.
EXPO_PUBLIC_DESMOS_API_KEY=REPLACE_WITH_PRODUCTION_DESMOS_API_KEY
