
NEXT_PUBLIC_ENABLE_SIGNUP=true
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Observability (Phase 4 of the backend's roadmap — see
# docs/observability/frontend-instrumentation-spec.md in the MVP repo).
# SDK is wired (src/instrumentation.ts, src/instrumentation-client.ts) and
# is a safe no-op with these unset. Fill in once a Sentry project exists.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time only: enables source-map upload so production stack traces map to
# real source. Create at Sentry → Settings → Auth Tokens (scope: project:releases).
# NEVER commit a real value — set it in Vercel / .env.local only.
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_ENVIRONMENT=development
# Release id — must match on both the browser SDK and the source-map upload.
# In Vercel, set to the git SHA (e.g. $VERCEL_GIT_COMMIT_SHA).
NEXT_PUBLIC_RELEASE=
